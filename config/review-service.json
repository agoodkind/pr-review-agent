{
  "metadata_findings_display": "expanded",
  "relationship_review": {
    "enabled": true,
    "maximum_pairs": 40
  },
  "file_classification": {
    "maximum_persisted_bytes": 48000,
    "maximum_evidence_bytes": 12000,
    "maximum_preview_bytes": 4000,
    "maximum_direct_review_bytes": 80000,
    "maximum_header_bytes": 1024,
    "header_patterns": [
      "(?i)\\A(?:#![^\\n]*\\n)?(?:[ \\t]*(?://|#|--|<!--)[^\\n]*\\n)*?[ \\t\\r\\n]*(?://|#|--|<!--)[ \\t]*(?:(?:This file (?:is|was)[ \\t]+)(?:automatically[ \\t]+)?)?(?:Code[ \\t]+)?Generated[^\\n]*do not edit",
      "(?i)\\A(?:#![^\\n]*\\n)?(?:[ \\t]*(?://|#|--|<!--)[^\\n]*\\n)*?[ \\t\\r\\n]*(?://|#|--|<!--)[ \\t]*This file (?:is|was) (?:automatically )?generated\\b",
      "(?is)\\A[ \\t\\r\\n]*/\\*[ \\t\\r\\n*]*(?:(?:This file (?:is|was)[ \\t]+)(?:automatically[ \\t]+)?)?(?:Code[ \\t]+)?Generated\\b(?:[^*]|\\*+[^*/])*?do not edit(?:[^*]|\\*+[^*/])*?\\*/"
    ],
    "uncertain_content_prefixes": [
      "$ANSIBLE_VAULT;",
      "-----BEGIN PGP MESSAGE-----",
      "age-encryption.org/v1"
    ],
    "review_overrides": [],
    "trusted_detectors": [
      {
        "detector": "linguist-generated",
        "kind": "generated",
        "reason": "Attributes declare generated output."
      },
      {
        "detector": "linguist-vendored",
        "kind": "dependency",
        "reason": "Attributes declare vendored dependencies."
      },
      {
        "detector": "generated",
        "kind": "generated",
        "reason": "The detector identifies generated output."
      },
      {
        "detector": "header",
        "kind": "generated",
        "reason": "The header declares generated output."
      },
      {
        "detector": "vendor",
        "kind": "dependency",
        "reason": "The detector identifies vendored code."
      },
      {
        "detector": "binary",
        "kind": "binary",
        "reason": "Policy excludes binary content."
      }
    ],
    "path_exclusions": [
      {
        "pattern": "*-lock.json",
        "kind": "dependency",
        "reason": "Policy excludes dependency lockfiles."
      },
      {
        "pattern": "*.lock",
        "kind": "dependency",
        "reason": "Policy excludes dependency lockfiles."
      },
      {
        "pattern": "go.sum",
        "kind": "dependency",
        "reason": "Policy excludes dependency checksums."
      },
      {
        "pattern": "yarn.lock",
        "kind": "dependency",
        "reason": "Policy excludes dependency lockfiles."
      },
      {
        "pattern": "pnpm-lock.yaml",
        "kind": "dependency",
        "reason": "Policy excludes dependency lockfiles."
      },
      {
        "pattern": "*.min.js",
        "kind": "generated",
        "reason": "Policy excludes generated build output."
      },
      {
        "pattern": "*.map",
        "kind": "generated",
        "reason": "Policy excludes generated build output."
      },
      {
        "pattern": "*.pyc",
        "kind": "binary",
        "reason": "Policy excludes compiled output."
      },
      {
        "pattern": "*.o",
        "kind": "binary",
        "reason": "Policy excludes compiled output."
      },
      {
        "pattern": "*.class",
        "kind": "binary",
        "reason": "Policy excludes compiled output."
      },
      {
        "pattern": "*.wasm",
        "kind": "binary",
        "reason": "Policy excludes compiled output."
      }
    ],
    "maximum_reason_bytes": 512,
    "maximum_evidence_references": 8,
    "allowed_exclusions": [
      "generated",
      "encrypted",
      "binary",
      "dependency",
      "data",
      "external"
    ]
  },
  "file_assessments_display": "collapsed",
  "limits": {
    "summary_sentences": 2,
    "inspection_requests": 6,
    "inspection_bytes": 12000
  },
  "provider_details": [
    "provider",
    "models",
    "settings",
    "requests",
    "tokens",
    "cost",
    "quota",
    "period_usage",
    "result"
  ],
  "failure_codes": [
    "server_error",
    "upstream_failed",
    "upstream_malformed_request",
    "invalid_request_error",
    "invalid_request",
    "invalid_api_key",
    "authentication_error",
    "permission_denied",
    "model_not_found",
    "context_length_exceeded",
    "missing_required_parameter",
    "unsupported_parameter",
    "unsupported_value",
    "request_failed",
    "insufficient_quota",
    "credit_balance_exhausted",
    "usage_limit_reached",
    "rate_limit_exceeded",
    "INTERNAL",
    "UNAVAILABLE",
    "DEADLINE_EXCEEDED",
    "UNAUTHENTICATED",
    "PERMISSION_DENIED",
    "INVALID_ARGUMENT",
    "NOT_FOUND",
    "RESOURCE_EXHAUSTED"
  ]
}
