{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agoodkind-nano-pr-reviewer",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "vars": {
    "CLYDE_BASE_URL": "https://clyde-suburban.goodkind.io/v1",
    "GITHUB_APP_ID": "4571682",
    "GITHUB_BOT_LOGIN": "goodkind-io-pr-agent[bot]",
    "LOG_FORWARD_URL": "https://agoodkind-nano-pr-reviewer.alex-ee7.workers.dev/internal/v1/service_logs",
    "PORT": "3000",
    "REVIEW_CHUNK_TIMEOUT": "5m",
    "REVIEW_MAX_CHUNKS": "60",
    "REVIEW_MAX_FILES": "100",
    "REVIEW_MIN_IMPORTANCE": "6",
    "REVIEW_MODEL": "gpt-5.6-sol",
    "REVIEW_WORKERS": "4"
  },
  "containers": [
    {
      "class_name": "PrAgentContainer",
      "image": "./Dockerfile",
      "image_vars": {
        "PR_REVIEW_AGENT_IMAGE": "IMAGE_DIGEST_IS_WRITTEN_BY_configure-image.mjs_NEVER_DEPLOY_THIS_FILE_RAW"
      },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PR_AGENT",
        "class_name": "PrAgentContainer"
      },
      {
        "name": "REPLAY_QUEUE",
        "class_name": "WebhookReplayQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrAgentContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WebhookReplayQueue"]
    }
  ]
}
