{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agoodkind-nano-pr-reviewer",
  "account_id": "ee7d7ca7d611ef8c2a07885e8362de0c",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "containers": [
    {
      "class_name": "PrAgentContainer",
      "image": "./Dockerfile",
      "image_vars": {
        "PR_REVIEW_AGENT_IMAGE": "IMAGE_DIGEST_IS_WRITTEN_BY_configure-image.mjs_NEVER_DEPLOY_THIS_FILE_RAW"
      },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PR_AGENT",
        "class_name": "PrAgentContainer"
      },
      {
        "name": "REPLAY_QUEUE",
        "class_name": "WebhookReplayQueue"
      },
      {
        "name": "PROVIDER_BUDGET",
        "class_name": "ProviderBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrAgentContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WebhookReplayQueue"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ProviderBudget"]
    }
  ]
}
