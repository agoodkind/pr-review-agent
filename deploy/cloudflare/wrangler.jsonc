{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agoodkind-nano-pr-reviewer",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "vars": {
    "CLYDE_BASE_URL": "https://clyde-suburban.goodkind.io/v1",
    "GITHUB_APP_ID": "4571682",
    "GITHUB_BOT_LOGIN": "goodkind-io-pr-agent[bot]",
    "PORT": "3000",
    "REVIEW_MAX_UNRESOLVED_COMMENTS": "3",
    "REVIEW_MIN_IMPORTANCE": "9",
    "REVIEW_TIMEOUT": "10m",
    "REVIEW_WORKERS": "4"
  },
  "containers": [
    {
      "class_name": "PrAgentContainer",
      "image": "./Dockerfile",
      "image_vars": {
        "PR_REVIEW_AGENT_IMAGE": "ghcr.io/agoodkind/pr-review-agent@sha256:a46b46853eb7f9dc8e19117c1c017f6040c53cb5602737fdf476c95002d376b5"
      },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PR_AGENT",
        "class_name": "PrAgentContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrAgentContainer"]
    }
  ]
}
