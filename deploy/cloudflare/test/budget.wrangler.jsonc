{
  "name": "pr-agent-budget-test",
  "main": "budget-fixture.js",
  "compatibility_date": "2026-08-12",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "PROVIDER_BUDGET", "class_name": "ProviderBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProviderBudget"] }
  ],
  "vars": {
    "GITHUB_WEBHOOK_SECRET": "test-review-budget-secret"
  }
}
